# Minimal host env for spm-service (prod, S1 10.254.26.33).
# Copy to: /usr/local/app/spm-service/spm-service.env  (chmod 600)
#
# 必须先推 Nacos Data ID `spm-service` 再启动，否则会连上 mis-common 的平台库。

MIS_REMOTE=true
NACOS_SERVER=10.254.26.36:8848
NACOS_NAMESPACE=prod
NACOS_CONFIG_GROUP=MIS_GROUP
NACOS_USERNAME=nacos
NACOS_PASSWORD=

# 闭店退券 Oracle（启动必填 CSCOUPON_*；口令勿提交 Git）
# CSCOUPON_JDBC_URL=jdbc:oracle:thin:@HOST:1521:SID
# CSCOUPON_DB_USER=
# CSCOUPON_DB_PASSWORD=
# HDCRM_JDBC_URL=jdbc:oracle:thin:@10.254.16.211:1521:thdcrm
# HDCRM_DB_USER=bfcrm8
# HDCRM_DB_PASSWORD=
# HDCZK_JDBC_URL=jdbc:oracle:thin:@10.254.16.211:1521:thdczk
# HDCZK_DB_USER=bfcrm8
# HDCZK_DB_PASSWORD=
