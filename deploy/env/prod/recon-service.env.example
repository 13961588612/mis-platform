# Minimal host env for recon-service (prod, S1 10.254.26.33). Copy to:
#   /usr/local/app/recon-service/recon-service.env
# 只放 Nacos 引导参数与主机级开关；库账号/连接串在 Nacos
# （deploy/nacos-config/prod/recon-service.yaml，推送后以配置中心为准）。

MIS_REMOTE=true
NACOS_SERVER=10.254.26.36:8848
NACOS_NAMESPACE=prod
NACOS_CONFIG_GROUP=MIS_GROUP

# 调度/通知（按需）
RECON_SCHEDULER_ENABLED=true
# RECON_NOTIFY_MAIL_TO=
# RECON_NOTIFY_WEBHOOK_URL=

# 需要临时覆盖 Nacos 里的库账号时再放开（优先级高于配置中心）
# RECON_DB_USER=
# RECON_DB_PASSWORD=
