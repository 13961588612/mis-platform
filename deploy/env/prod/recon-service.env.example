# Minimal host env for recon-service (prod, S1 10.254.26.33).
# Copy to: /usr/local/app/recon-service/recon-service.env  (chmod 600, unit uses UMask=0077)
#
# 主方案（配置中心）：本文件只放 Nacos 引导参数；库连接/业务配置在 Nacos
#   Data ID `recon-service`（namespace=prod, group=MIS_GROUP，
#   内容见 deploy/nacos-config/prod/recon-service.yaml）。
#
# ⚠️ 必须先推 Nacos 配置再启动服务：否则只会加载共享的 `mis-common`，
#    datasource 指向平台库 mis_platform，Flyway 会把对账表建进平台库。
#
# 备选（无 Nacos 权限时）：MIS_REMOTE=false，并在本文件补
#    SERVER_PORT / DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD。
#    recon-service 不依赖 mis-common 的 jar，关闭后全部走 jar 内 application.yml。

MIS_REMOTE=true
NACOS_SERVER=10.254.26.36:8848
NACOS_NAMESPACE=prod
NACOS_CONFIG_GROUP=MIS_GROUP
# Nacos 开启鉴权后必填，否则客户端匿名访问会报 403 user not found!
NACOS_USERNAME=nacos
NACOS_PASSWORD=

# ---- 业务开关（也可写进 Nacos）----
RECON_SCHEDULER_ENABLED=true
# 前端静态部署在 S2 10.254.26.34 的 /recon/ 子路径
RECON_CORS_ALLOWED_ORIGINS=http://10.254.26.34
# RECON_NOTIFY_MAIL_TO=
# RECON_NOTIFY_WEBHOOK_URL=
