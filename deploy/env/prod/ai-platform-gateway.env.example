# ai-platform-gateway (Agent Gateway) — prod on S2 10.254.26.34
# Copy to: /usr/local/app/ai-platform-gateway/.env
# Or: EnvironmentFile= in systemd (same content).
# Does NOT use Nacos; secrets stay on host.

NODE_ENV=production
GATEWAY_HOST=0.0.0.0
# ⚠ 必须 3100：代码默认 GATEWAY_PORT=8080，会与本机 mis-gateway 冲突
GATEWAY_PORT=3100
PORT=3100

# Redis DB 2 + AUTH（与 S1 Agent Core 一致；漏 /2 → WS 无回复）
# 密码含 # 时注意 URL 编码或换不用 # 的口令
REDIS_URL=redis://:CHANGE_ME@10.254.26.36:6379/2
REDIS_KEY_PREFIX=aip:

# Agent Core（S1）
AGENT_CORE_API_URL=http://10.254.26.33:8000
BACKEND_URL=http://10.254.26.33:8000

# Gateway 自有 HS256（强随机；openssl rand -hex 32）
JWT_SECRET=CHANGE_ME
JWT_ISSUER=ai-platform
JWT_ACCESS_TOKEN_TTL=7200

# 信任 MIS RS256（与 mis-gateway 共用公钥）
MIS_JWT_PUBLIC_KEY_PATH=/usr/local/app/keys/public.pem
MIS_JWT_ISSUER=mis-platform

# 与 S1 backend .env 的 GATEWAY_INTERNAL_TOKEN 必须同值（企微 Bot 热加载）
# openssl rand -hex 32
GATEWAY_INTERNAL_TOKEN=
BOT_CONFIG_POLL_INTERVAL_MS=30000

# 权限回源 BFF（S1）；PLATFORM_TOKEN 与 BFF 侧共享密钥对齐时可填
BFF_INTERNAL_URL=http://10.254.26.33:8081
PLATFORM_TOKEN=
BFF_PERMISSIONS_TIMEOUT_MS=3000

# CORS：按实际管理台 / 嵌入域填写，逗号分隔
CORS_ORIGINS=https://mis.example.com

# 企微（不用可留空）
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_BOT_ID=
WECOM_BOT_SECRET=

LOG_LEVEL=info
