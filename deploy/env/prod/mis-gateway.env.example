# Minimal host env for mis-gateway (prod, S2 10.254.26.34).
# Copy to: /usr/local/app/mis-gateway/mis-gateway.env
# Topology prefers Nacos; keep secrets here or fill in Nacos console.

MIS_REMOTE=true
NACOS_SERVER=10.254.26.36:8848
NACOS_NAMESPACE=prod
NACOS_CONFIG_GROUP=MIS_GROUP

# Required after Nacos auth is enabled:
NACOS_USERNAME=nacos
NACOS_PASSWORD=

# Redis AUTH (mis-common.yaml uses ${REDIS_PASSWORD:})
REDIS_PASSWORD=

# JWT verify only (public key on S2; private key stays on S1)
JWT_PUBLIC_KEY_PATH=/usr/local/app/keys/public.pem
