# Minimal host env for mis-iqd (prod). Copy to:
#   /usr/local/app/mis-iqd/mis-iqd.env
# Same shape as mis-admin-bff.env — DB/Redis come from Nacos mis-common only.

MIS_REMOTE=true
NACOS_SERVER=10.254.26.36:8848
NACOS_NAMESPACE=prod
NACOS_CONFIG_GROUP=MIS_GROUP
NACOS_USERNAME=nacos
# Quote if password contains # (bash source treats # as comment)
NACOS_PASSWORD=

# Do NOT put DB_HOST / REDIS_HOST here for prod.
# Ensure Nacos mis-common has spring.datasource.* and spring.data.redis.*
# and password is quoted if it contains #: password: "mis#1014"
