<?xml version="1.0" encoding="UTF-8"?>
<!--
  Place next to the JAR. scan=true reloads about every 60s after edits.
  Deploy dir example: /usr/local/app/mis-admin-bff/
  Start with: logging.config=file:/usr/local/app/mis-admin-bff/logback-spring.xml
  (Do not put double-hyphen sequences inside XML comments.)
-->
<configuration scan="true" scanPeriod="60 seconds">
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <!-- 可改：日志目录 / 文件名（可用环境变量 LOG_DIR 覆盖） -->
  <property name="LOG_DIR" value="${LOG_DIR:-/usr/local/app/mis-admin-bff/logs}"/>
  <property name="APP_NAME" value="mis-admin-bff"/>
  <property name="LOG_FILE" value="${LOG_DIR}/${APP_NAME}.log"/>

  <!-- 可改：控制台 / 文件格式（含 traceId） -->
  <property name="CONSOLE_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %X{traceId:-} %logger{36} - %msg%n"/>
  <property name="FILE_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %X{traceId:-} %logger{36} - %msg%n"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${CONSOLE_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- 按天 + 按大小滚动 -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_FILE}</file>
    <encoder>
      <pattern>${FILE_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
      <maxFileSize>100MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>3GB</totalSizeCap>
    </rollingPolicy>
  </appender>

  <!-- 可改：包级别 -->
  <logger name="com.mis.adminbff" level="INFO"/>
  <logger name="org.springframework" level="INFO"/>
  <logger name="com.alibaba.nacos" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
