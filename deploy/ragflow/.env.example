# 复制为 .env 后使用。禁止将含真实 API Key / 强密码的 .env 提交仓库。
#
# 带 `:?` 标记的变量在 docker-compose.yml 中为**必填**，未设置时 compose 会直接报错拒绝启动
# （MYSQL_PASSWORD / MINIO_PASSWORD / REDIS_PASSWORD / ELASTIC_PASSWORD）。

# ===== 版本钉扎（禁止 latest，与 README「已钉扎版本」表保持一致）=====
RAGFLOW_IMAGE=infiniflow/ragflow:v0.26.4
MYSQL_IMAGE_TAG=8.0.39
MINIO_IMAGE_TAG=RELEASE.2023-12-20T01-00-02Z
VALKEY_IMAGE_TAG=8
STACK_VERSION=8.11.3

# ===== 网络 =====
# 独立栈保持默认；与 deploy/docker-compose.dev.yml 叠加联调时，
# 改成 dev 栈的网络名，使 mis-kb 能按服务名解析 http://ragflow:80
RAGFLOW_NETWORK=mis-ragflow-net

# ===== 宿主机端口（已相对 MIS 开发栈偏移，避免冲突）=====
RAGFLOW_HTTP_PORT=9380
MYSQL_HOST_PORT=5455
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
REDIS_HOST_PORT=6479
ES_HOST_PORT=1200

# ===== 凭据（本地开发示例值；测试/生产必须改为强密码并走 Secret 注入）=====
MYSQL_PASSWORD=change-me-mysql
MYSQL_DBNAME=rag_flow
MINIO_USER=rag_flow
MINIO_PASSWORD=change-me-minio
REDIS_PASSWORD=change-me-redis
ELASTIC_PASSWORD=change-me-elastic

# ===== 资源 =====
# ES 堆内存：建议不超过宿主机内存一半；低配机可降到 512m
ES_HEAP_SIZE=1g
REDIS_MAXMEMORY=256mb

# ===== RAGFlow 运行参数 =====
# 检索引擎：elasticsearch | infinity（切换需清空 ragflow-es 卷后重建）
DOC_ENGINE=elasticsearch
TIMEZONE=Asia/Shanghai

# ===== 与 mis-kb 的对接（写入 Nacos，不在此文件生效）=====
# 引擎起来后在 RAGFlow Web 控制台创建 API Key，填到 mis-kb 的 Nacos 配置：
#   mis.kb.engine.type=ragflow
#   mis.kb.engine.base-url=http://ragflow:80
#   mis.kb.engine.api-key=<RAGFlow API Key>
# API Key 绝不提交 Git，绝不下发前端。
