# 本地开发环境变量（复制为 .env 后按需修改）
# cp .env.example .env

# 纯本地不连 Nacos（必填）：各服务 bootstrap 默认 MIS_REMOTE=true
MIS_REMOTE=false

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mis_platform
DB_USER=mis
DB_PASSWORD=mis123

# JDK 17（Maven 父 POM 引用 ${env.JAVA_HOME_17}）
JAVA_HOME_17=C:/Program Files/Eclipse Adoptium/jdk-17.0.11.9-hotspot

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Nacos（MIS_REMOTE=true 或不设时使用；默认即连 Nacos）
NACOS_SERVER=localhost:8848
NACOS_NAMESPACE=dev
NACOS_CONFIG_GROUP=MIS_GROUP

# JWT（开发用，生产走 Secret 挂载）
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

AUTH_CAPTCHA_ENABLED=true
AUTH_COOKIE_SECURE=false
MIS_DEFAULT_PASSWORD=Mis@123456
AI_PLATFORM_BASE_URL=http://127.0.0.1:8000
AI_PLATFORM_SSE_ENABLED=true
AI_PLATFORM_BFF_SHARED_SECRET=change-me-in-prod
AGENT_OPS_CHAT_TIMEOUT_MS=180000
# MIS_KB_ENGINE_API_KEY=
