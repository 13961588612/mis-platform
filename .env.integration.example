# 混合联调环境变量（IDE Run Configuration / 复制为 .env.integration）
MIS_REMOTE=true
NACOS_SERVER=localhost:8848
NACOS_NAMESPACE=integration
NACOS_CONFIG_GROUP=MIS_GROUP
# 容器内 Gateway 访问宿主机 IDE 实例（Windows/macOS Docker Desktop）
NACOS_REGISTER_IP=host.docker.internal

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mis_platform
DB_USER=mis
DB_PASSWORD=mis123
# Hikari 每服务上限（本机连共享 PG 建议 5）
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=1

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_PRIVATE_KEY_PATH=./backend/keys/private.pem
JWT_PUBLIC_KEY_PATH=./backend/keys/public.pem

AUTH_CAPTCHA_ENABLED=false
AUTH_COOKIE_SECURE=false

# Shared defaults / secrets referenced by Nacos ${ENV} placeholders
MIS_DEFAULT_PASSWORD=Mis@123456
MIS_JWT_ISSUER=mis-platform
# MIS_JWT_PUBLIC_KEY=
AI_PLATFORM_BASE_URL=http://127.0.0.1:8000
AI_PLATFORM_SSE_ENABLED=true
AI_PLATFORM_REVERSE_TRUST_ENABLED=true
AI_PLATFORM_BFF_SHARED_SECRET=change-me-in-prod
# AI_PLATFORM_TRUSTED_NETWORK=
# AI_PLATFORM_DOC_SERVICE_BASE_URL=
AGENT_OPS_BACKEND_BASE_URL=http://127.0.0.1:8000
AGENT_OPS_GATEWAY_BASE_URL=http://127.0.0.1:3100
AGENT_OPS_TIMEOUT_MS=15000
AGENT_OPS_CHAT_TIMEOUT_MS=180000
# MIS_KB_ENGINE_TYPE=ragflow
# MIS_KB_ENGINE_BASE_URL=http://127.0.0.1:9380
# MIS_KB_ENGINE_API_KEY=
# MIS_KB_RERANK_MODEL_ID=

# 运行集成测试
# MIS_INTEGRATION_TEST=true
# MIS_GATEWAY_URL=http://localhost:8080
