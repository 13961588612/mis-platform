{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@/lib/api/client": ["qa-tests/stubs/api-client.ts"],
      "@/*": ["src/*"]
    },
    "rootDir": "..",
    "outDir": ".out",
    "noEmitOnError": true
  },
  "include": ["./**/*.ts", "../src/lib/api/posts.ts"]
}
