# 构建机复制为 .env.production 后再 npm run build（VITE_* 会打进静态包）
# 生产同域部署时，业务 API / Agent 均走相对路径，由 Nginx 分流，一般不必改 API base。

# 嵌入父域白名单（逗号分隔）。空 = fail-closed（嵌入拒收父页 postMessage）
# 须与 nginx frame-ancestors、agent_external_host.allowed_origins 对齐
VITE_PARENT_ORIGINS=http://oa.springland.com.cn:81

# 旧 Agent H5 独立源（T11 后主路径为同域 /embed；无独立 H5 可留空或填本站）
# VITE_AI_H5_ORIGIN=https://mis.example.com
