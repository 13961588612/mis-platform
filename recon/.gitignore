# =============================================================================
# recon 子项目 — Git 忽略规则（与仓库根规则对齐；recon 独立成库时仍可独立使用）
# =============================================================================

# ----- IDE / 编辑器 -----
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# ----- 操作系统 -----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ----- 环境变量与密钥 -----
.env
.env.local
.env.*.local
.env.integration
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.jks
keys/

# ----- Java / Maven -----
target/
*.class
*.jar
*.war
hs_err_pid*
replay_pid*
*.orig
*.rej

# ----- 日志（含后缀变体：*.log.1、*.log.prev、*.log.err） -----
*.log
*.log.*
*.pid
**/logs/**
!**/logs/.gitignore

# ----- Node / 前端 -----
node_modules/
dist/
dist-ssr/
.pnpm-store/
# Vite 依赖预打包缓存（每次 dev 启动都会重建）
.vite/
.turbo/
.eslintcache
*.tsbuildinfo
coverage/
.nyc_output/

# ----- 临时产物 -----
*.tmp
*.temp
.cache/

# ----- Docker volumes（若挂载到仓库内） -----
.deploy-data/

# ----- Windows 保留名误建垃圾文件 -----
/nul
