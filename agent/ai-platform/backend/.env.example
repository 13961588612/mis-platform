# =============================================================================
# Backend Environment Variables — Example Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# In production, use Docker environment variables or a secrets manager.
# =============================================================================

# ===== Application =====
APP_NAME=ai-platform-backend
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_FILE=logs/backend.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ===== Server =====
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ===== PostgreSQL =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aiplatform
POSTGRES_PASSWORD=aiplatform_dev_password
POSTGRES_DB=ai_platform

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=2
REDIS_PASSWORD=

# ===== Chat attachments (local disk; no public URL required) =====
UPLOAD_DIR=data/uploads
UPLOAD_MAX_BYTES=10485760

# ===== Qdrant =====
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# ===== Embedding Model =====
EMBEDDING_SERVICE_URL=http://embedding:8001
EMBEDDING_MODEL_NAME=bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
# 无 embedding 服务时设 false，跳过 Skill 向量索引（工具注册仍正常）
SKILL_VECTOR_INDEX_ENABLED=true
EMBEDDING_TIMEOUT_SECONDS=15

# ===== LLM Gateway（默认主 Qwen / 备 DeepSeek）=====
LLM_PRIMARY_PROVIDER=qwen
LLM_FALLBACK_PROVIDER=deepseek
# 文本+工具：qwen3.7-plus；识图：qwen-vl-plus 或 qwen3-vl-plus
LLM_PRIMARY_MODEL=qwen3.7-plus
LLM_FALLBACK_MODEL=deepseek-v4-flash

DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/v1

QWEN_API_KEY=your-qwen-api-key-here
QWEN_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== LLM Token 日配额（可选；覆盖 configs/system/system.yaml cost_control）=====
# 未设置时读 system.yaml：per_user=100000 / per_department=1000000 / alert=0.8 / hard_limit=true
# LLM_QUOTA_PER_USER=5000000
# LLM_QUOTA_PER_DEPARTMENT=20000000
# LLM_QUOTA_ALERT_THRESHOLD=0.8
# LLM_QUOTA_HARD_LIMIT=true

# ===== Outbound Proxy =====
OUTBOUND_PROXY_ENABLED=true
OUTBOUND_PROXY_HOST=outbound-proxy
OUTBOUND_PROXY_PORT=3128
# 额外允许的 LLM 域名/IP（逗号分隔或 JSON 数组；DEEPSEEK/QWEN 端点 host 会自动放行）
# OUTBOUND_PROXY_ALLOWED_DOMAINS=10.254.6.83,api.example.com

# ===== JWT / Authentication =====
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Dev Test Accounts =====
DEV_TEST_ACCOUNTS_ENABLED=true
TEST_ACCOUNTS_FILE=test-accounts.yaml

STREAM_CONSUMER_ENABLED=true
STREAM_CONSUMER_GROUP=agent-core-group
# 入站消费并发：进程内同时处理上限；每次 XREADGROUP 条数
INBOUND_MAX_CONCURRENCY=8
INBOUND_READ_COUNT=1
# Agent 单条消息处理超时（秒）；MCP 单次工具调用超时（秒）
AGENT_MESSAGE_TIMEOUT=120
MCP_TOOL_CALL_TIMEOUT=30

# ===== Enterprise WeChat =====
WECOM_CORP_ID=your-corp-id
WECOM_AGENT_ID=your-agent-id
WECOM_SECRET=your-secret
WECOM_ENCODING_AES_KEY=your-encoding-aes-key
WECOM_TOKEN=your-callback-token
WECOM_BOT_CALLBACK_TOKEN=your-bot-callback-token
WECOM_BOT_CALLBACK_ENCODING_AES_KEY=your-bot-aes-key

# ===== Credential Vault (AES-256-GCM, 32 bytes) =====
CREDENTIAL_VAULT_KEY=change-this-to-32-byte-secure-key!

# ===== Config Manager =====
CONFIG_MODE=file_system
CONFIG_BASE_PATH=/app/configs
CONFIG_WATCH_ENABLED=true

# ===== Agent Router =====
AGENT_ROUTER_DEFAULT_AGENT=default-agent

# ===== Knowledge Base (mis-kb) / RAG =====
# mis-kb 内网基址；mis-rag 带用户 JWT 调其 /internal/v1/kb/** 内部端点
MIS_KB_BASE_URL=http://mis-kb:8108
# 服务账号令牌：仅当请求未携带用户 JWT 时兜底使用；留空表示只透传用户 JWT
MIS_KB_AGENT_TOKEN=
MIS_KB_TIMEOUT_SECONDS=20
# KB 问答管线总开关；false 时 mis-rag 退化为纯提示词问答
MIS_KB_QA_ENABLED=true
MIS_KB_RETRIEVE_TOP_K=5
MIS_KB_SNIPPET_LIMIT=200
MIS_KB_MAX_CONTEXT_CHARS=6000

# ===== mis-admin-bff 对接 / T03 权限闸门（fail-closed）=====
# BFF 自身端口是 8081（8080 是 mis-gateway；网关只路由 /api/v1/**，/internal/** 经网关必然 404）。
#  - 与 BFF 同处一个 docker network：http://mis-admin-bff:8081
#  - BFF 跑在宿主机、本服务在容器内：http://host.docker.internal:8081 或 http://<宿主机IP>:8081
#  - 两者都在宿主机：http://127.0.0.1:8081（勿写 localhost，Windows 会先解析 ::1）
MIS_ADMIN_BFF_BASE_URL=http://mis-admin-bff:8081
# 必须与 BFF 的 mis.ai-platform.service-token 一致；不一致 → /internal/** 401
# → 权限码回源失败 → 所有 skill/MCP 被 fail-closed 拒绝（现象与 BFF 宕机一模一样）。
AI_PLATFORM_BFF_SHARED_SECRET=change-me-in-prod
# 权限码回源路径（挂在 MIS_ADMIN_BFF_BASE_URL 之下）
MIS_ACL_PERMISSIONS_PATH=/internal/permissions
# 权限闸门总开关：生产必须 true。禁止用 false 绕过——那是权限绕过漏洞，不是修复。
MIS_ACL_ENABLED=true
# 权限码缓存 TTL（秒）。⚠ 必须与 Java 侧 SkillPermissionChecker.CACHE_TTL 一致（60s）：
# 两语言共享同一 Redis key mis:acl:skillperm:{userId}，TTL 不一致 → 缓存寿命取决于谁先写。
MIS_ACL_CACHE_TTL=60
MIS_ACL_HTTP_TIMEOUT=3.0

# Local: mis-iqd (default http://mis-iqd:8109 is Docker-only)
IQD_INTERNAL_API_BASE_URL=http://127.0.0.1:8109

# ===== WrenAI / IQD MCP（跨机器管理面）=====
# WREN_AGENT_ENDPOINT=http://10.20.0.20:9100
# WREN_AGENT_TOKEN=
# 非交互 memory reset 须跳过确认，否则 abort（W0：--force / -f）
WREN_SELF_HEAL_MEMORY_RESET_ARGS=["--force"]
# WREN_SELF_HEAL_FORCE_BUILD_ARGS=["--force"]
# ===== IQD NL2SQL Dedicated Model =====
# 仅接管问数 SQL 生成：NL->SQL 与 cube 规格生成；不影响外层回答模型 LLM_PRIMARY_MODEL。
# 为空时回退 LLM_PRIMARY_MODEL，保持向后兼容。
IQD_NL2SQL_MODEL=deepseek-v4-flash
# 问数 SQL 生成关闭 Qwen thinking，降低 completion tokens 与延迟；不支持该参数的 provider 会忽略。
IQD_NL2SQL_ENABLE_THINKING=false
# SQL 生成稳定性参数：低温度、足够但不过大的输出上限。
IQD_NL2SQL_TEMPERATURE=0.0
IQD_NL2SQL_MAX_TOKENS=1024
# 单次问数 SQL 生成超时（秒）；为空/0 时沿用网关默认。
IQD_NL2SQL_TIMEOUT_SECONDS=30
# 可选：模型别名不含 deepseek/qwen 时显式指定 provider；为空则按模型名自动识别。
IQD_NL2SQL_PROVIDER=
