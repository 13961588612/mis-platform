# WrenMcpAgent 运行环境示例（wren 机；复制为 .env 后填写）
# 鉴权：bearer-token + 内网网络隔离（决策 ②⑥：去 mTLS，无双向证书）
# ⚠ 必须与 ai-platform 侧 WREN_AGENT_TOKEN 完全一致；防火墙仅放行 ai-platform 源 IP。

# 控制面监听端口（WrenMcpAgentClient 调此）
WREN_AGENT_CONTROL_PORT=9100
# 数据面 MCP 反向代理端口（ai-platform orchestrator 经此问数）
WREN_AGENT_MCP_PORT=9101
# 监听地址（数据面须可被 ai-platform 内网直达）
WREN_AGENT_BIND_HOST=0.0.0.0
# ai-platform 可达地址（回执 control_endpoint/mcp_endpoint 用；跨机器数据面可达性，决策 ①⑧）。
# ⚠ 多网卡/容器化时务必设为 ai-platform 可路由到的 IP 或服务名；缺省取 BIND_HOST(=0.0.0.0，不可达)。
WREN_AGENT_PUBLIC_HOST=
# 共享 bearer token（空=仅依赖内网隔离放行；生产务必配置）
WREN_AGENT_TOKEN=

# wren CLI 绝对路径（systemd 下 PATH 通常不含 ~/wren-venv/bin，勿只写 wren）
# 例：WREN_AGENT_WREN_CLI_BIN=/root/wren-venv/bin/wren
WREN_AGENT_WREN_CLI_BIN=/root/wren-venv/bin/wren

# wren project 根目录（每连接 project_home = {root}/{connId}）；须位于持久卷
WREN_AGENT_PROJECTS_ROOT=/var/lib/mis-iqd/wren-projects
# 本机端口段（按连接分配/回收；≤10 DB 决策 ⑦）
WREN_AGENT_WREN_PORT_RANGE=18080-18180
# 自愈健康循环间隔（秒）
WREN_AGENT_HEALTH_INTERVAL_SECONDS=15
# 单次拉起等待 ready 超时（秒）
WREN_AGENT_START_TIMEOUT_SECONDS=60
# 并发连接上限（决策 ⑦ ≤10）
WREN_AGENT_MAX_CONNECTIONS=10
