# WrenMcpAgent systemd 单元（wren 机，Linux + 持久卷，决策 ④）
# 安装：
#   sudo cp wren-mcp-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now wren-mcp-agent
[Unit]
Description=WrenMcpAgent (mis-iqd 多连接 WrenAI MCP 跨机器 supervisor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 不单独建 wrenagent：默认以 root 跑（systemctl）；若改用普通部署账号，
# 取消下行注释并改成实际用户，且 ~/.wren 与目录属主须与该用户一致。
# User=deploy
# Group=deploy
WorkingDirectory=/opt/wren-mcp-agent
ExecStart=/opt/wren-mcp-agent/.venv/bin/python agent.py
# 缺省兜底（无 .env 或未写某键时生效）；生产以 .env 为准
# 鉴权：bearer-token + 内网隔离（决策 ②⑥：去 mTLS，无双向证书）
# token 须与 ai-platform 侧 WREN_AGENT_TOKEN 一致；防火墙仅放行 ai-platform 源 IP（决策 ⑤）
Environment=WREN_AGENT_TOKEN=__CHANGE_ME__
Environment=WREN_AGENT_CONTROL_PORT=9100
Environment=WREN_AGENT_MCP_PORT=9101
Environment=WREN_AGENT_BIND_HOST=0.0.0.0
Environment=WREN_AGENT_PROJECTS_ROOT=/var/lib/mis-iqd/wren-projects
Environment=WREN_AGENT_WREN_PORT_RANGE=18080-18180
Environment=WREN_AGENT_MAX_CONNECTIONS=10
# A 方案：主配置来自 .env（须在 Environment= 之后，同名键以 .env 为准）
# 复制 .env.example → .env 后填写 TOKEN / PUBLIC_HOST / WREN_CLI_BIN 等；chmod 600
# 前缀 - 表示文件缺失时不导致 unit 失败
EnvironmentFile=-/opt/wren-mcp-agent/.env
Restart=always
RestartSec=5
# 凭证临时文件即用即删（S1）；umask 保证临时 env 文件 0600
UMask=0077

[Install]
WantedBy=multi-user.target
