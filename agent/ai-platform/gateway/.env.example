# =============================================================================
# Gateway — Local Development Environment
# =============================================================================

NODE_ENV=development
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3100

# Redis（本地 Docker 或本机实例）
# 须与 Agent Core REDIS_DB=2 一致（融合决策 R2）；漏写 /2 会导致「WS 已连接但无回复」
REDIS_URL=redis://127.0.0.1:6379/2

# JWT（需与签发 Token 的服务一致）
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ISSUER=ai-platform
JWT_ACCESS_TOKEN_TTL=7200

# Agent Core（本地 uvicorn 端口）
AGENT_CORE_API_URL=http://127.0.0.1:8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 企业微信自建应用（H5 / JS-SDK）
WECOM_CORP_ID=your-corp-id
WECOM_AGENT_ID=your-agent-id
WECOM_SECRET=your-secret

# 智能机器人长连接（企微官方 BotID + Secret；留空则跳过）
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# 高级覆盖项，默认 wss://openws.work.weixin.qq.com；一般不要填写
WECOM_BOT_WS_URL=

# 企微 Bot 配置热加载轮询周期（毫秒，O1f-2；默认 30000；0 或缺失 = 不轮询，退回启动时装载）
# 仅当 GATEWAY_INTERNAL_TOKEN 非空时轮询才会启动（无 token 拉取本就禁用，保持 fail-closed）
BOT_CONFIG_POLL_INTERVAL_MS=30000

# ===== A2UI 渲染权限反查（SurfacePermissionFilter 两级缓存回退的 BFF 源） =====
# BFF 内网基址（默认 http://mis-admin-bff:8080）
BFF_INTERNAL_URL=http://127.0.0.1:9000
# BFF 反向信任令牌（X-Platform-Token 共享密钥；留空 = BFF 回源不可用 → 受控组件 fail-closed 降级）
PLATFORM_TOKEN=
# BFF 权限反查超时（毫秒，默认 3000）
BFF_PERMISSIONS_TIMEOUT_MS=3000

# 须大于 AGENT_MESSAGE_TIMEOUT×1000，避免长 A2UI 任务 PEL 误重投（默认 32min）
XCLAIM_MIN_IDLE_MS=1920000

LOG_LEVEL=debug
